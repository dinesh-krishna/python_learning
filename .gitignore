# IDE/editor metadata
.idea/
.vscode/

# Local environment backups
*.bak

# Optional: ignore compiled extension outputs if ever added
*.so

# Optional: ignore Jupyter notebook checkpoints if used later
.ipynb_checkpoints

# Optional: project-specific temp output if used later
*.log
